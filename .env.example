# ==============================================================================
# NIFTY 50 Pro Terminal — Environment Variables Configuration
# Copy this file to .env on your live server: cp .env.example .env
# ==============================================================================

# 1. Angel One SmartAPI Credentials (Live Broker WebSocket & Market Data)
ANGEL_API_KEY=your_angel_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PASSWORD=your_trading_pin_here
ANGEL_TOTP_SECRET=your_totp_secret_alphanumeric_here

# 2. Market Contract Configuration
DEFAULT_EXCHANGE=NSE
DEFAULT_SYMBOL=NIFTY 50
DEFAULT_TOKEN=99926000
MOCK_MODE=false

# 3. Telegram 24/7 Alerts Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_PHONE=your_phone_number_here
TELEGRAM_ENABLED=true

# 4. Google Gemini API Key (For Strategy Copilot & Vector RAG)
GEMINI_API_KEY=your_gemini_api_key_here

# 5. Terminal Authentication & Security
JWT_SECRET_KEY=generate_a_random_64_character_hex_secret_here
ADMIN_MASTER_KEY=choose_a_strong_secret_master_password_here

# 6. Real SMS Gateway API (Fast2SMS / Twilio) for Mobile OTP Authentication & Number Collection
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# 7. Server Network Configuration
HOST=0.0.0.0
PORT=8000
